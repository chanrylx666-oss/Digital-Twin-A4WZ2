<Window x:Class="DigitalTwinA4WZ2.Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="Digital-Twin-A4WZ2 四工位动平衡机上位机"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#101B2D"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DIGITAL-TWIN-A4WZ2" FontSize="22"
                               FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="四工位卧式钻孔动平衡机 · 上位机控制与数据平台"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#173C38" CornerRadius="14" Padding="14,7" Margin="5">
                        <TextBlock Text="● SIMULATION 模拟模式" Foreground="#5DE1C7"/>
                    </Border>
                    <Border Background="#18263B" CornerRadius="14" Padding="14,7" Margin="5">
                        <TextBlock Text="{Binding ConnectionText}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="14"
                    Background="{StaticResource PageBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    SelectionChanged="MainTabControl_OnSelectionChanged">
            <TabItem Header="生产总览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="整机状态" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="{Binding MachineStateText}" FontSize="25" FontWeight="SemiBold" Margin="0,5"/>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="当前周期" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="{Binding CycleId, StringFormat=CYCLE-{0:000000}}" FontSize="24" Margin="0,8"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="测量转速" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="{Binding SpeedRpm, StringFormat={}{0:F0} rpm}" FontSize="24" Margin="0,8"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="运行模式" Foreground="{StaticResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding OperatingModes}" SelectedItem="{Binding SelectedOperatingMode}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10" Margin="5,12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="▶ 启动单周期" Command="{Binding StartCycleCommand}" Background="#147D6B"/>
                                <Button Content="■ 停止" Command="{Binding StopCommand}" Background="#7A3340"/>
                                <Button Content="↻ 故障复位" Command="{Binding ResetCommand}"/>
                                <TextBlock Text="四工位全部准备后同时启动；全部进入终态后才统一夹取转位。"
                                           Margin="20,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Stations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}"
                                            BorderBrush="{Binding AccentBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="16" Margin="5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Number, StringFormat=工位 {0}}"
                                                       Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Name}" FontSize="17" Margin="0,8"/>
                                            <Separator Background="#32445F"/>
                                            <TextBlock Text="{Binding StateText, StringFormat=状态：{0}}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding ResultText, StringFormat=结果：{0}}"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="8"
                                                         Margin="0,14,0,5" Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="双面平衡模拟测量">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="12">
                                        <TextBlock Text="A 面（左通道）" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding LeftAmplitude, StringFormat={}{0:F3} g·mm}" FontSize="22" Margin="0,8"/>
                                        <TextBlock Text="{Binding LeftPhase, StringFormat=相位 {0:F1}°}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12">
                                        <TextBlock Text="B 面（右通道）" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding RightAmplitude, StringFormat={}{0:F3} g·mm}" FontSize="22" Margin="0,8"/>
                                        <TextBlock Text="{Binding RightPhase, StringFormat=相位 {0:F1}°}"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="实时提示">
                                <ListBox ItemsSource="{Binding RecentLogs}" Background="#0D1727"
                                         BorderThickness="0" Foreground="{StaticResource TextBrush}" MaxHeight="150">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="3"/></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DigitalTwinTab" Header="数字孪生">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="8"
                            Padding="14,10" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="重新加载数字孪生"
                                        Click="RestartDigitalTwinButton_OnClick"
                                        Background="#147D6B"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Godot 4.6 C# 三维设备画面"
                                           FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DigitalTwinStatusText"
                                           Text="首次进入此页面时自动启动数字孪生"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Background="#050A12"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="1">
                        <wfi:WindowsFormsHost x:Name="GodotWindowsFormsHost">
                            <wf:Panel x:Name="GodotHostPanel" BackColor="#050A12"/>
                        </wfi:WindowsFormsHost>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="模拟调试">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="场景与时钟">
                        <StackPanel>
                            <TextBlock Text="预置故障场景" Margin="4"/>
                            <ComboBox ItemsSource="{Binding SimulationScenarios}" SelectedItem="{Binding SelectedScenario}"/>
                            <TextBlock Text="模拟时间倍率" Margin="4,16,4,4"/>
                            <ComboBox ItemsSource="{Binding TimeScales}" SelectedItem="{Binding SelectedTimeScale}"/>
                            <TextBlock Text="确定性随机种子" Margin="4,16,4,4"/>
                            <TextBox Text="{Binding RandomSeed}"/>
                            <TextBlock Text="无料、测量失败、钻孔失败允许转位；通信断开和测速丢失会产生报警。"
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="4,20"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="模拟数据说明">
                        <StackPanel Margin="8">
                            <TextBlock Text="当前首期实现" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                       Text="进程内模拟器生成四个独立工位时间；采集器生成两路压电动态力和一路红外每转基准。所有结果带模拟标识。"/>
                            <TextBlock Text="数据通道" FontWeight="SemiBold" Margin="0,16,0,8"/>
                            <TextBlock Text="CH0  左侧压电动态力"/>
                            <TextBlock Text="CH1  右侧压电动态力"/>
                            <TextBlock Text="CH2  红外每转基准脉冲"/>
                            <TextBlock Text="协议级联调参数" FontWeight="SemiBold" Margin="0,16,0,8"/>
                            <TextBlock Text="虚拟 M200：127.0.0.1:1502；真实 M200 默认：192.168.0.10:502"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="手动 / 维修">
                <StackPanel Margin="24">
                    <TextBlock Text="独立动作调试" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="当前按钮产生模拟请求；接入真实 PLC 后仍由 PLC 安全联锁决定是否执行。"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,20"/>
                    <WrapPanel>
                        <Button Content="1  转臂升降" Command="{Binding ManualActionCommand}" CommandParameter="转臂升降"/>
                        <Button Content="2  四夹具夹取" Command="{Binding ManualActionCommand}" CommandParameter="四夹具夹取"/>
                        <Button Content="3  转臂旋转" Command="{Binding ManualActionCommand}" CommandParameter="转臂旋转"/>
                        <Button Content="4  四夹具放置" Command="{Binding ManualActionCommand}" CommandParameter="四夹具放置"/>
                        <Button Content="5  测速模块移动" Command="{Binding ManualActionCommand}" CommandParameter="测速模块移动"/>
                        <Button Content="6  主轴启停" Command="{Binding ManualActionCommand}" CommandParameter="主轴启停"/>
                        <Button Content="7  钻头进退" Command="{Binding ManualActionCommand}" CommandParameter="钻头进退"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="配方">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="测量与合格标准">
                        <StackPanel>
                            <TextBlock Text="配方名称"/><TextBox Text="{Binding RecipeName}"/>
                            <TextBlock Text="目标转速 (rpm)" Margin="0,10,0,0"/><TextBox Text="{Binding RecipeSpeedRpm}"/>
                            <TextBlock Text="A 面合格阈值 (g·mm)" Margin="0,10,0,0"/><TextBox Text="{Binding PlaneATolerance}"/>
                            <TextBlock Text="B 面合格阈值 (g·mm)" Margin="0,10,0,0"/><TextBox Text="{Binding PlaneBTolerance}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="钻孔修正参数">
                        <StackPanel>
                            <TextBlock Text="最大钻孔深度 (mm)"/><TextBox Text="{Binding MaximumDrillDepth}"/>
                            <TextBlock Text="测量失败后最大重测次数" Margin="0,10,0,0"/><TextBox Text="{Binding MaximumRemeasureCount}"/>
                            <Button Content="保存并校验配方" Command="{Binding SaveRecipeCommand}"
                                    Background="#147D6B" Margin="4,24"/>
                            <TextBlock Text="{Binding RecipeValidationText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock Grid.Column="2" Margin="25" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="当前版本以 JSON 保存。正式生产阶段将增加登录权限、配方版本、审核人与生效记录。"/>
                </Grid>
            </TabItem>

            <TabItem Header="报警与日志">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="报警">
                        <DataGrid ItemsSource="{Binding Alarms}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#0D1727" Foreground="White" RowBackground="#111C2E"
                                  AlternatingRowBackground="#152239">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding OccurredAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180"/>
                                <DataGridTextColumn Header="编号" Binding="{Binding Code}" Width="110"/>
                                <DataGridTextColumn Header="等级" Binding="{Binding Severity}" Width="100"/>
                                <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*"/>
                                <DataGridCheckBoxColumn Header="活动" Binding="{Binding IsActive}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="运行日志">
                        <DataGrid ItemsSource="{Binding RecentLogs}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#0D1727" Foreground="White" RowBackground="#111C2E"
                                  AlternatingRowBackground="#152239">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="190"/>
                                <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="90"/>
                                <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="通信设置">
                <StackPanel Margin="28" Width="520" HorizontalAlignment="Left">
                    <TextBlock Text="Schneider Modicon M200 / Modbus TCP" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="PLC 地址"/><TextBox Text="{Binding PlcHost}"/>
                    <TextBlock Text="TCP 端口" Margin="0,10,0,0"/><TextBox Text="{Binding PlcPort}"/>
                    <TextBlock Text="请求超时 (ms)" Margin="0,10,0,0"/><TextBox Text="{Binding CommunicationTimeoutMilliseconds}"/>
                    <Button Content="保存通信设置" Command="{Binding SaveSettingsCommand}"
                            Background="#147D6B" Margin="4,20,4,8"/>
                    <TextBlock Text="{Binding SettingsValidationText}" TextWrapping="Wrap"/>
                    <TextBlock Text="真实模式连接失败时禁止新命令并报警；命令使用序号和确认寄存器防止超时后重复执行。"
                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,22"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#07101D" Padding="14,6">
            <DockPanel>
                <TextBlock Text="模拟数据 · 仅供软件调试" Foreground="#E6B85C" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentTimeText}" DockPanel.Dock="Right"
                           HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
